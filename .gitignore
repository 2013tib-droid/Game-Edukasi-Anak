# Dependencies
node_modules/

# Build output
dist/
# Build sementara untuk menguji lawan Firebase Emulator
# (VITE_USE_EMULATOR=1 ... npx vite build --outDir dist-emu) — jangan pernah
# ikut ter-commit, dan JANGAN pernah ter-deploy: bundel ini menunjuk
# 127.0.0.1, jadi di HP pembeli ia tidak bisa masuk akun sama sekali.
dist-emu/
*.tsbuildinfo

# Vite dependency pre-bundle cache (dibuat dev server / build, bukan sumber)
.vite/

# Firebase
.firebase/
firebase-debug.log
*-debug.log

# Env — real Firebase keys live here, never commit
.env
.env.local
.env.*.local

# Editor/OS
.DS_Store
.idea/
.vscode/

# Kunci service account Firebase (admin penuh) & hasil cetak kode aktivasi.
# Repo ini PUBLIK: kunci yang ter-commit = siapa pun bisa membaca/menulis
# Firestore, dan CSV yang ter-commit = kode jualan dibagikan gratis.
# Pola ini sengaja luas supaya salah nama pun tetap tertahan.
kunci*.json
# Secret lokal emulator Cloud Functions (token webhook Mayar, App Password Gmail).
functions/.secret.local
serviceAccount*.json
service-account*.json
*-firebase-adminsdk-*.json
kode*.csv
