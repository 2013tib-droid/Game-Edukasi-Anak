rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Users may read their own profile. `access` (paid groups) and
    // `referralRedeemed` are written ONLY by Cloud Functions (Admin SDK
    // bypasses these rules): clients may create their profile with an
    // empty access map and may never change either field afterwards.
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.access.size() == 0
        && !('referralRedeemed' in request.resource.data);
      allow update: if isOwner(uid)
        && request.resource.data.access == resource.data.access
        && request.resource.data.get('referralRedeemed', {}) == resource.data.get('referralRedeemed', {});
      allow delete: if false;

      // Device fingerprints (max-3-devices limit, Phase 5)
      match /devices/{deviceId} {
        allow read, write: if isOwner(uid);
      }

      // Kid's progress (stars per game/level)
      match /progress/{gameId} {
        allow read, write: if isOwner(uid);
      }

      // Server-managed counters (rate limiting) — no client access
      match /private/{docId} {
        allow read, write: if false;
      }
    }

    // Codes and purchases are processed exclusively via Cloud Functions.
    match /activation_codes/{code} {
      allow read, write: if false;
    }

    match /referral_codes/{code} {
      allow read, write: if false;
    }

    match /purchases/{purchaseId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
