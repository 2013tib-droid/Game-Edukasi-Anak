# Salin file ini menjadi `.env` lalu isi dari Firebase Console:
# Project Settings → General → Your apps → SDK setup and configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Arahkan app ke Firebase Emulator lokal (auth 9099 / firestore 8080 /
# functions 5001). Isi 1 HANYA saat mengembangkan dengan `npm run emulators`;
# kosongkan untuk build produksi.
VITE_USE_EMULATOR=

# --- Nilai demo untuk menguji Fase 5 tanpa project Firebase asli ---
# Emulator menerima project id berawalan "demo-" tanpa kredensial apa pun,
# jadi `.env` di bawah ini cukup untuk mencoba alur aktivasi end-to-end:
#
#   VITE_FIREBASE_API_KEY=demo-key
#   VITE_FIREBASE_AUTH_DOMAIN=demo-gea.firebaseapp.com
#   VITE_FIREBASE_PROJECT_ID=demo-gea
#   VITE_FIREBASE_STORAGE_BUCKET=demo-gea.appspot.com
#   VITE_FIREBASE_MESSAGING_SENDER_ID=1
#   VITE_FIREBASE_APP_ID=1:1:web:1
#   VITE_USE_EMULATOR=1
