# Salin file ini menjadi `.env` lalu isi dari Firebase Console:
# Project Settings → General → Your apps → SDK setup and configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Mode kunci game (opsional). 'buka' = semua game terbuka (pra-rilis/testing),
# 'kunci' = hanya game di FREE_GAME_IDS (src/data/access.ts) yang gratis.
# Kalau kosong, dipakai DEFAULT_LOCK_MODE di src/data/access.ts.
VITE_LOCK_MODE=
