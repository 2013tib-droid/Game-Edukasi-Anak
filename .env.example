# Salin file ini menjadi `.env` lalu isi dari Firebase Console:
# Project Settings → General → Your apps → SDK setup and configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Mode kunci game (opsional). 'buka' = semua game terbuka (pra-rilis/testing),
# 'kunci' = hanya game di FREE_GAME_IDS (src/data/access.ts) yang gratis.
# Kalau kosong, dipakai DEFAULT_LOCK_MODE di src/data/access.ts.
VITE_LOCK_MODE=

# Menyalakan saklar penguji 🔓/🔒 dan `?test=1`. HARUS KOSONG di build yang
# dijual — kalau diisi, pembeli bisa membuka semua game sendiri lewat saklar
# itu. Diisi '1' hanya untuk build penguji di HP sendiri:
#   VITE_ALLOW_TEST_TOGGLE=1 VITE_LOCK_MODE=kunci npm run build
VITE_ALLOW_TEST_TOGGLE=

# Menyambung ke Firebase Emulator Suite, bukan project sungguhan. Untuk
# menguji alur berbayar (kode aktivasi, batas perangkat) tanpa menyentuh data
# pembeli. Jalankan emulatornya: npx firebase emulators:start
VITE_USE_EMULATOR=
VITE_EMULATOR_HOST=

# Azure Speech — untuk merender narasi jadi file suara (`npm run suara`).
# Ambil dari portal.azure.com → resource Speech → "Keys and Endpoint".
# Hanya dipakai skrip render di komputer, TIDAK pernah dikirim ke browser
# (makanya tanpa awalan VITE_ — kunci ber-awalan VITE_ ikut ke bundle publik).
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia
